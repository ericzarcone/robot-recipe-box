# Copy to .env and fill in.

# The public HTTPS URL of the app (your Cloudflare Tunnel hostname). Used in the links Claude returns.
PUBLIC_BASE_URL=https://recipes.example.com

# Cloudflare Access. Every request must carry a valid Access JWT, so the app cannot be reached around Access.
# Team domain: Zero Trust > Settings > Team name and domain (for example "myteam" or "myteam.cloudflareaccess.com").
CF_ACCESS_TEAM_DOMAIN=
# Application Audience (AUD) tag: Zero Trust > Access controls > Applications > Configure > Additional settings.
CF_ACCESS_AUD=
# Optional second check after Cloudflare's own policy. Comma separated. Empty = anyone the Access policy allows.
ALLOWED_EMAILS=

# Cloudflare Tunnel token (Zero Trust > Networks > Tunnels > your tunnel > Docker command).
TUNNEL_TOKEN=

# Local development only. Turns off all authentication. Never use it on a machine reachable from the internet.
# DEV_NO_AUTH=true
